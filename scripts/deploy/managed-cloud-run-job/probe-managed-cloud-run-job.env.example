# Required runtime secrets. Prefer mounting these from Secret Manager.
PROBE_MANAGED_ASSIGNMENT_TOKEN=
PROBE_MANAGED_ASSIGNMENT_SIGNING_SECRET=
PROBE_MANAGED_CALLBACK_BEARER_TOKEN=

# Required for OpenAI-compatible or Codex-backed profiles when no saved auth
# state is baked/mounted into PROBE_HOME.
PROBE_OPENAI_API_KEY=
PROBE_OPENAI_API_KEY_SOURCE=hosted_secret:secret-manager/probe-managed-openai-api-key

# Normal Cloud Run Job settings.
PROBE_HOME=/var/lib/probe
PROBE_MANAGED_CWD=/workspace
PROBE_MANAGED_PROFILE=openai-codex-subscription
PROBE_MANAGED_JOB_ARTIFACT_DIR=/var/lib/probe/managed/cloud-run-job/artifacts
PROBE_MANAGED_ARTIFACT_GCS_PREFIX=gs://openagents-managed-agent-artifacts/example-run

# Optional operator metadata.
PROBE_MANAGED_CLOUD_RUN_LOGS_URL=
PROBE_MANAGED_SYSTEM_PROMPT=
PROBE_MANAGED_PRETTY=false
PROBE_MANAGED_DRY_RUN=false
