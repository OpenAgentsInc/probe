PROBE_MANAGED_CONTROLLER_BASE_URL=https://openagents.com
PROBE_MANAGED_WORKER_BEARER_TOKEN=
PROBE_MANAGED_WORKER_BEARER_TOKEN_FILE=
PROBE_MANAGED_WORKER_ID=
PROBE_MANAGED_ENVIRONMENT_CLASS=gcp-coding-standard
PROBE_MANAGED_WORKER_PROFILE=openai-codex-subscription
PROBE_MANAGED_CWD=/workspace
PROBE_HOME=/var/lib/probe
PROBE_MANAGED_WORKER_ARTIFACT_DIR=/var/lib/probe/managed/cloud-run-worker-pool/artifacts
PROBE_MANAGED_ARTIFACT_GCS_PREFIX=gs://openagents-managed-agent-artifacts/probe-worker-pool
PROBE_MANAGED_WORKER_POLL_INTERVAL_MS=1000
PROBE_MANAGED_WORKER_EXIT_ON_IDLE=0
PROBE_MANAGED_WORKER_IMAGE_REF=us-central1-docker.pkg.dev/PROJECT/REPOSITORY/probe-managed-worker-pool:latest
PROBE_MANAGED_WORKER_CPU_MILLICORES=4000
PROBE_MANAGED_WORKER_MEMORY_MIB=8192
PROBE_MANAGED_WORKER_DISK_MIB=51200
PROBE_MANAGED_GCP_REGION=us-central1
PROBE_MANAGED_CLOUD_RUN_LOGS_URL=
PROBE_OPENAI_API_KEY=
PROBE_OPENAI_API_KEY_SOURCE=secret-manager:probe-managed-worker-openai
